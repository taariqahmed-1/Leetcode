import heapq


class Solution:
    def kClosest(self, points: list[list[int]], k: int) -> list[list[int]]:
        max_heap = []

        for x, y in points:
            dist_sq = x * x + y * y
            entry = (-dist_sq, x, y)

            if len(max_heap) < k:
                heapq.heappush(max_heap, entry)
            elif dist_sq < -max_heap[0][0]:
                heapq.heapreplace(max_heap, entry)

        return [[x, y] for _, x, y in max_heap]
